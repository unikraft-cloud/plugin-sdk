{{- /* The dial behind doDial, rendered only for a spec with an operation that
       upgrades to a WebSocket (see api.go.tmpl).  A browser's WebSocket sends
       no headers, so the handshake cannot carry the bearer token there, and
       the js build refuses to dial rather than be refused. */ -}}
{{- $anyWS := false -}}
{{- range .Operations -}}
{{- if .Operation.Responses.Value "101" -}}{{- $anyWS = true -}}{{- end -}}
{{- end -}}
{{- if $anyWS -}}
--- dial.gen.go
// Code generated by unikraft.com/cloud/pluginsdk/tools/sdkgen. DO NOT EDIT.

//go:build !js

package {{ .Var "package" "client" }}

import (
	"context"
	"net/http"

	"github.com/coder/websocket"
)

// dial opens the WebSocket req asks for, through client.  On a refusal the
// response says why.
func dial(ctx context.Context, req *http.Request, client *http.Client) (*websocket.Conn, *http.Response, error) {
	return websocket.Dial(ctx, req.URL.String(), &websocket.DialOptions{HTTPClient: client, HTTPHeader: req.Header})
}
--- dial_js.gen.go
// Code generated by unikraft.com/cloud/pluginsdk/tools/sdkgen. DO NOT EDIT.

//go:build js

package {{ .Var "package" "client" }}

import (
	"context"
	"errors"
	"fmt"
	"net/http"

	"github.com/coder/websocket"
)

// dial refuses: a browser's WebSocket sends no Authorization header, so the
// plugin's handshake cannot be made from one.
func dial(context.Context, *http.Request, *http.Client) (*websocket.Conn, *http.Response, error) {
	return nil, nil, fmt.Errorf("a browser's WebSocket carries no credentials: %w", errors.ErrUnsupported)
}
{{- end }}

        query: {
          {{- range $query }}
          {{ toJson .Name }}: params[{{ toJson .Name }}],
          {{- end }}
        },
        {{- end }}
        {{- if $bodyRef }}
        body: params.body,
        {{- end }}
      },
      {{- if $header }}
      {
        ...params,
        headers: {
          {{- range $header }}
          ...(params[{{ toJson .Name }}] !== undefined ? { {{ toJson .Name }}: String(params[{{ toJson .Name }}]) } : {}),
          {{- end }}
          ...params.headers,
        },
      },
      {{- else }}
      params,
      {{- end }}
    );
  }
{{- end -}}

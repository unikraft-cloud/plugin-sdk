{{- with $entry.Ref -}}{{- with .Value -}}{{- if .Content -}}
{{- $handled := false -}}
{{- with index .Content "application/json" -}}
{{- $handled = true -}}{{- $kinds = append $kinds "application/json" -}}
{{- $type := "unknown" -}}{{- with .Schema -}}{{- $type = qualifyModels "models" (tsTypeRef .) -}}{{- end -}}

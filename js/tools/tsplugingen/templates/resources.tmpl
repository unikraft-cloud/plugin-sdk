{{- end -}}{{- end -}}{{- end -}}
{{- with $po.PathItem -}}{{- range .Parameters -}}{{- with .Value -}}{{- if eq .In "cookie" -}}
{{- fail (printf "%s %s: parameter %q is a cookie, which the templates cannot send" $po.Method $po.Path .Name) -}}
{{- end -}}{{- end -}}{{- end -}}{{- end -}}
{{- /* fetch cannot send a body on GET or HEAD, so an optional body is
       dropped. */ -}}
{{- if or (eq .Method "GET") (eq .Method "HEAD") -}}
{{- if $bodyReq -}}
{{- fail (printf "%s %s requires a request body, which fetch cannot send on %s" .Method .Path .Method) -}}
{{- end -}}
{{- $bodyRef = false -}}
{{- $bodyReq = false -}}

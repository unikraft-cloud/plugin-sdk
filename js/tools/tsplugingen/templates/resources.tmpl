             escapes it, so the name cannot break the literal. */}}
      {{- range $query }}
      {{ toJson .Name }}{{ if not .Required }}?{{ end }}: {{ qualifyModels "models" (paramToTsType .) }};
      {{- end }}
      {{- range $header }}
      {{ toJson .Name }}{{ if not .Required }}?{{ end }}: {{ qualifyModels "models" (paramToTsType .) }};
      {{- end }}
      {{- if $bodyRef }}
      body{{ if not $bodyReq }}?{{ end }}: {{ qualifyModels "models" (tsTypeRef $bodyRef) }};
      {{- end }}

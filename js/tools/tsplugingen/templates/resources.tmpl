{{- end -}}
{{- with index .Content "text/event-stream" -}}
{{- $handled = true -}}{{- $kinds = append $kinds "text/event-stream" -}}
{{- $type := "unknown" -}}{{- with .Schema -}}{{- $type = qualifyModels "models" (tsTypeRef .) -}}{{- end -}}
{{- $rets = append $rets $type -}}
{{- end -}}
{{- with index .Content "application/octet-stream" -}}
{{- $handled = true -}}{{- $kinds = append $kinds "application/octet-stream" -}}{{- $rets = append $rets "Uint8Array" -}}
{{- end -}}

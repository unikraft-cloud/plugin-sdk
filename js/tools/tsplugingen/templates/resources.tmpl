{{- end -}}
{{- $query := queryParameters $po -}}
{{- /* An operation parameter overrides a path-item parameter with the same
       name and location. */ -}}
{{- $header := list -}}
{{- $headerNames := list -}}
{{- range $op.Parameters -}}{{- with .Value -}}
{{- if eq .In "header" -}}
{{- $header = append $header . -}}{{- $headerNames = append $headerNames .Name -}}
{{- end -}}
{{- end -}}{{- end -}}
{{- with $po.PathItem -}}
{{- range .Parameters -}}{{- with .Value -}}
{{- if and (eq .In "header") (not (has .Name $headerNames)) -}}

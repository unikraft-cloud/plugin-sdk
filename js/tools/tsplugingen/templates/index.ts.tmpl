{{- $ops := .Operations -}}
{{- $tags := uniqueTags $ops -}}
{{- $plugin := .Var "pluginName" "plugin" -}}
{{- $class := printf "%sPluginApi" (pascalcase $plugin) -}}
{{- /* pascalcase keeps a leading digit, which TypeScript rejects in a class
       name. */ -}}
{{- if not (regexMatch "^[A-Za-z_$][A-Za-z0-9_$]*$" $class) -}}
{{- fail (printf "plugin name %q cannot name a TypeScript class" $plugin) -}}
{{- end -}}
--- src/index.ts

{{- /* Models for one API surface: enum aliases, the pydantic models, then the
  union aliases.

  Python evaluates a module top to bottom, where TypeScript's declarations are
  order-free, so this is laid out to survive the parser's alphabetical order:
  self-contained enum aliases first, then the models with deferred annotations,
  then the aliases for schemas that are only a union of models -- an assignment
  is evaluated on the spot, unlike an annotation, so its branches must already
  exist -- and a rebuild pass once every name does. */ -}}
{{- $module := .Var "module" "unikraft_cloud_plugin_api" -}}
{{- /* A schema name is rendered as it is, in its declaration and in every
  reference, so it must be an identifier that nothing in the module takes: an
  import, a type the annotations name, or the loop variable of the rebuild. */ -}}
{{- $moduleNames := list "Any" "BaseModel" "ConfigDict" "Field" "Literal" "annotations" "bool" "datetime" "dict" "float" "int" "list" "str" }}
{{- $schemaNames := list }}
{{- range $m := .Models }}{{ $schemaNames = append $schemaNames $m.SchemaName }}{{ end }}
{{- range $m := .Models }}
{{- $name := $m.SchemaName }}
{{- if or (not (regexMatch "^[A-Za-z_][A-Za-z0-9_]*$" $name)) (ne (pySafeName $name) $name) }}
{{- fail (printf "schema %q cannot name a Python class; rename it in the plugin's api.tsp" $name) }}
{{- end }}
{{- if or (has $name $moduleNames) (eq $name "_model") }}
{{- fail (printf "schema %q has a name that the models module takes; rename it in the plugin's api.tsp" $name) }}
{{- end }}
{{- end }}
{{- /* A request model is named `Request`, or is one hop from one and in no
  response. A workaround: name the schema in api.tsp (README, "Request models"). */ -}}
{{- $named := list }}
{{- range $m := .Models }}
{{- if and (contains "Request" $m.SchemaName) (not (contains "Response" $m.SchemaName)) }}{{ $named = append $named $m.SchemaName }}{{ end }}
{{- end }}
{{- /* Every type a request renders, and every type a non-request renders. */ -}}
{{- $fromRequests := "" }}
{{- $fromOthers := "" }}
{{- /* A field name is derived here, once, and looked up where the field is
  rendered, so the imports the fields need are known before them. */ -}}
{{- $fieldNames := dict }}
{{- $needField := false }}
{{- $needDatetime := false }}
{{- $needLiteral := false }}
{{- range $m := .Models }}
{{- $name := $m.SchemaName }}
{{- if $m.Schema.Enum }}{{ $needLiteral = true }}{{ end }}
{{- /* Only an alias renders its own type; a class renders its fields. */ -}}
{{- $schema := $m.Schema }}
{{- $union := and (or $schema.OneOf $schema.AnyOf) (not $schema.Properties) }}
{{- $scalar := and (not $schema.Properties) (not $schema.OneOf) (not $schema.AnyOf) (not $schema.AllOf) $schema.Type (not ($schema.Type.Is "object")) }}
{{- $map := and (not $schema.Properties) (not $schema.OneOf) (not $schema.AnyOf) (not $schema.AllOf) (or (not $schema.Type) ($schema.Type.Is "object")) (or $schema.AdditionalProperties.Schema (eq (toJson $schema.AdditionalProperties.Has) "true")) }}
{{- $types := "" }}
{{- if and (not $schema.Enum) (or $union $scalar $map) }}{{ $types = schemaToPyType $schema }}{{ end }}
{{- range $prop := propertyNamesOrdered $name $m.Schema }}
{{- $p := getProperty $m.Schema $prop }}
{{- $types = printf "%s %s" $types (schemaToPyType $p) }}
{{- if eq $p.Format "date-time" }}{{ $needDatetime = true }}{{ end }}
{{- /* A field is an attribute, and one with a leading underscore is private to
  pydantic, so a name that is no public identifier is spelled in snake case
  and kept as the alias; one that still is none is refused. */ -}}
{{- $safe := pySafeName $prop }}
{{- if not (regexMatch "^[A-Za-z][A-Za-z0-9_]*$" $safe) }}{{ $safe = pySafeName (snakecase $prop) }}{{ end }}
{{- if not (regexMatch "^[A-Za-z][A-Za-z0-9_]*$" $safe) }}
{{- fail (printf "property %q of %s cannot name a Python field, even in snake case; rename it in the specification" $prop $name) }}
{{- end }}
{{- /* pydantic keeps `model_` for its own members, and the methods of its
  first version shadow a field with a warning, so both are spelled apart. */ -}}
{{- if hasPrefix "model_" $safe }}{{ $safe = printf "field_%s" $safe }}{{ end }}
{{- if has $safe (list "construct" "copy" "dict" "from_orm" "json" "parse_file" "parse_obj" "parse_raw" "schema" "schema_json" "update_forward_refs" "validate") }}{{ $safe = printf "%s_" $safe }}{{ end }}
{{- /* A field with a default is an attribute of the class body, where the
  annotations and defaults of later fields are resolved, so it may not take a
  name that they use. */ -}}
{{- if or (has $safe (list "Any" "Field" "Literal" "bool" "datetime" "dict" "float" "int" "list" "str")) (has $safe $schemaNames) }}{{ $safe = printf "%s_" $safe }}{{ end }}
{{- if ne $safe $prop }}{{ $needField = true }}{{ end }}
{{- $_ := set $fieldNames (printf "%s.%s" $name $prop) $safe }}
{{- end }}
{{- if has $name $named }}{{ $fromRequests = printf "%s %s" $fromRequests $types }}{{ else }}{{ $fromOthers = printf "%s %s" $fromOthers $types }}{{ end }}
{{- end }}
{{- $needAny := regexMatch "\\bAny\\b" (printf "%s %s" $fromRequests $fromOthers) }}
{{- if regexMatch "\\bLiteral\\b" (printf "%s %s" $fromRequests $fromOthers) }}{{ $needLiteral = true }}{{ end }}
{{- range $op := .Operations }}
{{- with requestJSONSchema $op.Operation }}{{ $fromRequests = printf "%s %s" $fromRequests (pyTypeRef .) }}{{ end }}
{{- range $entry := sortedResponseCodes $op.Operation.Responses }}{{ with $entry.Ref }}{{ with .Value }}
{{- range $media, $content := .Content }}{{ with $content.Schema }}{{ $fromOthers = printf "%s %s" $fromOthers (pyTypeRef .) }}{{ end }}{{ end }}
{{- end }}{{ end }}{{ end }}
{{- end }}
{{- $requests := $named }}
{{- range $m := .Models }}
{{- $name := $m.SchemaName }}
{{- if and (not (has $name $named)) (regexMatch (printf "\\b%s\\b" $name) $fromRequests) (not (regexMatch (printf "\\b%s\\b" $name) $fromOthers)) }}
{{- $requests = append $requests $name }}
{{- end }}
{{- end }}

{{- $ops := .Operations -}}
{{- $tags := uniqueTags $ops -}}
{{- $plugin := .Var "pluginName" "plugin" -}}
{{- $module := .Var "module" "unikraft_cloud_plugin_api" -}}
{{- $class := printf "%sPluginApi" (pascalcase $plugin) -}}
{{- /* pascalcase keeps a leading digit, which Python rejects in a class name. */ -}}
{{- if not (regexMatch "^[A-Za-z_][A-Za-z0-9_]*$" $class) -}}
{{- fail (printf "plugin name %q cannot name a Python class" $plugin) -}}
{{- end -}}
{{- /* The tag names are checked by "tagNames" in resources.tmpl, once for
       both templates. */ -}}
{{- template "tagNames" (dict "tags" $tags "plugin" $plugin) -}}
--- src/{{ $module }}/__init__.py
# Code generated by openapi-gen; DO NOT EDIT.
#
# The `{{ $plugin }}` plugin API's "plumbing" layer: the generated clients, plus
# a container that groups them behind one transport. Everything here returns
# the response envelope exactly as the OpenAPI specification describes it, or,
# for an operation that answers with raw bytes, the payload untouched.

from __future__ import annotations

from . import models_gen as models
from ._meta import CONFIG_HASH, SDK_MIN, SPEC_HASH, TEMPLATES_HASH, VERSION
{{- range $tag := $tags }}
from .{{ snakecase $tag }}_gen import {{ pascalcase $tag }}Api
{{- end }}
from .transport import CallOptions, QueryValue, RawResponse, Transport

__all__ = [
    "CONFIG_HASH",
    "PLUGIN_NAME",
    "SDK_MIN",
    "SPEC_HASH",
    "TEMPLATES_HASH",
    "VERSION",
{{- range $tag := $tags }}
    "{{ pascalcase $tag }}Api",
{{- end }}
    "CallOptions",
    "QueryValue",
    "RawResponse",
    "{{ $class }}",
    "Transport",
    "models",
]

__version__ = VERSION

#: The name the plugin is attached to an instance under, unless the instance's
#: creator chose another, and hence the ``<name>`` in its route.
PLUGIN_NAME = "{{ $plugin }}"

#: What a transport must offer, for the error that names a missing one.
_TRANSPORT_METHODS = ("request", "request_no_content", "request_bytes", "stream")


class {{ $class }}:
    """Every `{{ $plugin }}` plugin API resource, raw, behind one transport.

    The idiomatic layer in ``unikraft_cloud`` derives the plugin's route from an
    instance. Use this class only when you want the raw envelopes against a
    route you already have.

    .. code-block:: python

        import os

        from unikraft_cloud.core.http import ApiClient, ApiClientConfig
        from {{ $module }} import {{ $class }}

        uuid = "..."  # The instance the plugin is attached to.
        api = {{ $class }}(
            ApiClient(
                ApiClientConfig(
                    base_url=f"https://api.fra.unikraft.cloud/v1/instances/{uuid}/plugins/{{ $plugin }}",
                    token=os.environ["UKC_TOKEN"],
                )
            )
        )
    """

    def __init__(self, transport: Transport) -> None:
        missing = [name for name in _TRANSPORT_METHODS if not callable(getattr(transport, name, None))]
        if missing:
            raise TypeError(
                f"The transport has no {missing[0]}() method. Pass an ApiClient from "
                "unikraft_cloud.core.http, or an object with "
                f"{', '.join(_TRANSPORT_METHODS)}."
            )
        #: The transport every request goes through.
        self.transport = transport
{{- range $tag := $tags }}
        #: The `{{ $tag }}` resource of this plugin.
        self.{{ snakecase $tag }} = {{ pascalcase $tag }}Api(transport)
{{- end }}
